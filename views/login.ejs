<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>User Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
  <style>
    
  </style>
</head>
<body>

<div class="container">
  <div class="card shadow p-4 mx-auto" style="max-width: 420px;">
    <h3 class="text-center mb-4 text-primary">User Login</h3>

    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-danger text-center"><%= error %></div>
    <% } %>

    <% if (typeof success !== 'undefined') { %>
      <div class="alert alert-success text-center"><%= success %></div>
    <% } %>

    <form id="loginForm" action="/login" method="POST" novalidate>
      <div class="mb-3">
        <label class="form-label fw-semibold">Email Address</label>
        <input type="email" name="email" id="email" class="form-control" placeholder="Enter your email">
        <div id="emailError" class="error-text">Please enter a valid email.</div>
      </div>

      <div class="mb-3">
        <label class="form-label fw-semibold">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Enter your password" minlength="6">
        <div id="passwordError" class="error-text">Password must be at least 6 characters.</div>
      </div>

      <div class="text-center mt-3">
        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Login</button>
      </div>

      <div class="text-center mt-3">
        <a href="/signup" class="btn btn-link">Create Account</a>
      </div>

      <hr>

      <div class="text-center mt-2">
        <a href="/admin/login" class="text-muted">Login as <strong>Admin</strong></a>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/login.js"></script>

</body>
</html>
