<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Home</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/home.css">
  
</head>

<body>

  
  <nav class="navbar navbar-dark shadow-sm">
    <div class="container d-flex justify-content-between align-items-center">
      <span class="navbar-brand fs-4">User Homepage</span>
      <a href="/logout" class="btn btn-outline-light btn-logout px-3">Logout</a>
    </div>
  </nav>


  <div class="center-content">
    <% if (typeof success !== 'undefined') { %>
      <div class="alert alert-success w-50 mx-auto text-center"><%= success %></div>
    <% } %>

    <div class="welcome-card">
      <h1>Welcome, <%= user.name %></h1>
      <p>You are successfully logged in to your account.</p>
    </div>
  </div>


 
  <script>
    window.addEventListener('pageshow', function (event) {
      if (event.persisted) {
        window.location.reload();
      }
    });
  </script>

</body>
</html>
