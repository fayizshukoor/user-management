<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>User Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/adminLogin.css">

  <style>
   
  </style>
</head>
<body>

  <div class="container">
    <div class="card p-4 mx-auto" style="max-width: 400px; width: 100%;">
      <h3 class="text-center mb-4 text-primary">Admin Login</h3>

      <% if (typeof error !== 'undefined') { %>
        <div class="alert alert-danger text-center"><%= error %></div>
      <% } %>

      <form id="adminLoginForm" action="/admin/login" method="POST" novalidate>
        <div class="mb-3">
          <label class="form-label fw-semibold">Email</label>
          <input type="email" name="email" id="email" class="form-control" placeholder="Enter admin email">
          <div id="emailError" class="error-text">Please enter a valid email address.</div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Password</label>
          <input type="password" name="password" id="password" class="form-control" placeholder="Enter password">
          <div id="passwordError" class="error-text">Password must be at least 6 characters long.</div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Login</button>
      </form>

      <div class="text-center mt-3">
        <a href="/login" class="text-decoration-none text-muted">Go to <strong>User Login</strong></a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/adminLogin.js"></script>
</body>
</html>
